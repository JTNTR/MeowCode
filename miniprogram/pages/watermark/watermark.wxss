/* pages/watermark/watermark.wxss */

/* ==================== Hero 区 ==================== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.hero-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* ==================== 输入区 ==================== */
.input-card {
  width: 100%;
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input-row {
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.url-input {
  width: 100%;
  min-height: 160rpx;
  max-height: 400rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.input-placeholder {
  color: #BBB;
  font-size: 26rpx;
}

.input-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.btn-paste {
  font-size: 26rpx;
  color: #888;
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
}

.btn-clear {
  font-size: 26rpx;
  color: #BBB;
  padding: 12rpx 24rpx;
}

.btn-parse {
  font-size: 28rpx;
  color: #FFF;
  padding: 16rpx 48rpx;
  background: #CCC;
  border-radius: 40rpx;
  font-weight: 600;
  transition: background 0.2s;
}

.btn-parse-active {
  background: linear-gradient(135deg, #FF6B8A, #FF8E9E);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.3);
}

.btn-parse-active:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ==================== 加载动画 ==================== */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.paw-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.paw {
  font-size: 48rpx;
  animation: pawBounce 0.6s ease-in-out infinite;
}

.paw-1 { animation-delay: 0s; }
.paw-2 { animation-delay: 0.15s; }
.paw-3 { animation-delay: 0.3s; }

@keyframes pawBounce {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-20rpx); opacity: 1; }
}

.loading-text {
  font-size: 26rpx;
  color: #BB9A9A;
}

/* ==================== 错误区 ==================== */
.error-area {
  width: 100%;
  background: #FFF;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #FF6B8A;
  animation: fadeInUp 0.4s ease-out;
}

.error-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.error-text {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.btn-retry {
  font-size: 28rpx;
  color: #FF6B8A;
  padding: 14rpx 40rpx;
  border: 2rpx solid #FF6B8A;
  border-radius: 40rpx;
}

/* ==================== 结果卡片 ==================== */
.result-card {
  width: 100%;
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 138, 0.08);
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-author {
  font-size: 24rpx;
  color: #FF6B8A;
  margin-top: 8rpx;
}

/* 视频提示 */
.video-tip {
  background: #FFF7E6;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #FFA940;
}

.video-url-text {
  font-size: 20rpx;
  color: #AAA;
  word-break: break-all;
  text-align: center;
  max-height: 60rpx;
  overflow: hidden;
}

.video-note {
  font-size: 22rpx;
  color: #CCC;
  text-align: center;
  line-height: 1.6;
}

.video-cover {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: #FFF1D6;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.image-grid::after {
  content: '';
  width: calc(50% - 8rpx);
}

.image-cell {
  width: calc(50% - 8rpx);
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #F5F5F5;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-index {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.image-save-btn {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.image-save-btn:active {
  transform: scale(0.9);
  background: #FF6B8A;
}

/* 结果操作按钮 */
.result-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.btn-save-all {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B8A, #FF8E9E);
  color: #FFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.3);
}

.btn-save-all:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-saving {
  background: #CCC;
  box-shadow: none;
}

/* ==================== 提示卡片 ==================== */
.tips-card {
  width: 100%;
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #888;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 24rpx;
  color: #AAA;
  line-height: 1.8;
}

/* ==================== 页脚 ==================== */
.footer {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 20rpx;
  font-size: 22rpx;
  color: #DDC0C0;
}