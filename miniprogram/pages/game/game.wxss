/* pages/game/game.wxss */

page {
  background-color: #FFF5F0;
}

.container {
  padding: 0 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.hero-emoji {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B8A, #FF8E6B);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #CC9A9A;
}

/* ===== 分组标题 ===== */
.section-label {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 24rpx 0 18rpx 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8C7A7A;
}

.section-label-muted {
  margin-top: 36rpx;
  color: #BFAEAE;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FF6B8A;
  margin-right: 12rpx;
}

.dot-muted {
  background: #E0D0D0;
}

/* ===== 可玩卡片 ===== */
.game-card {
  width: 100%;
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #FFD6E0;
  transition: all 0.15s;
}

.game-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.09);
}

.game-card.card-pink { border-left-color: #FF6B8A; }
.game-card.card-blue { border-left-color: #69C0FF; }
.game-card.card-orange { border-left-color: #FFA940; }
.game-card.card-purple { border-left-color: #D3ADF7; }
.game-card.card-teal { border-left-color: #5CDBD3; }

.game-icon-box {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.icon-cube { background: linear-gradient(135deg, #FFF0F3, #FFD6E0); }
.icon-soon { background: linear-gradient(135deg, #F7F3FF, #E9E1F7); }

.game-emoji {
  font-size: 56rpx;
}

.game-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.game-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #AAA;
}

.game-arrow {
  font-size: 44rpx;
  color: #E0C8CC;
  line-height: 1;
  padding-left: 10rpx;
}

/* ===== 敬请期待 ===== */
.soon-grid {
  width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.soon-card {
  width: 47%;
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx 18rpx 22rpx;
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  opacity: 0.72;
  border-top: 6rpx solid #F0E4E4;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.soon-card.card-blue { border-top-color: #BAE7FF; }
.soon-card.card-teal { border-top-color: #C1F0E8; }
.soon-card.card-orange { border-top-color: #FFE7BA; }
.soon-card.card-purple { border-top-color: #EFDBFF; }

.soon-icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  background: #FAF6F6;
}

.soon-emoji {
  font-size: 42rpx;
}

.soon-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #777;
  margin-bottom: 6rpx;
}

.soon-desc {
  font-size: 22rpx;
  color: #BBB;
}

/* ===== 底部 ===== */
.footer-tip {
  width: 100%;
  text-align: center;
  padding: 40rpx 0 10rpx;
}

.footer-tip text {
  font-size: 24rpx;
  color: #DDC0C0;
}
